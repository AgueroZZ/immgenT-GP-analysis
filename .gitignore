.Rproj.user
.Rhistory
.RData
.Ruserdata
.DS_Store

# Symlinked to the immgen-t-factors project (not portable to another
# machine); not tracked here, and the symlink itself is excluded too since
# gitignore's directory-only "data/" pattern doesn't match a symlink.
data

# Large regenerable script-to-script handoff (rebuilt by script/Figure7b.R)
output/Figure7b/7b_cell_metadata.csv.gz

# Local Claude Code config (machine-specific absolute paths)
.claude/

# Published supplementary tables (journal artifacts, used only as
# verification ground truth -- see code/README.md; not produced here)
tables/

# Local exploration that isn't part of the published record: side-by-side
# metric/ordering comparisons, their intermediate .rds handoffs, and the
# plan/log notes that drove them. Kept on disk, out of the public repo.
experiments/
plan/
log/

# Regenerable non-panel diagnostics written by script/Figure2.R (the
# active-cell/active-gene histograms and the PVE-colored scatter). The rest of
# output/ (the Figure 7b intermediates) IS tracked.
output/Figure2/

# Local staging for panel re-lettering experiments -- copies of panels under
# trial letters, not part of the published record. Untracked directories show
# up in the workflowr status report embedded in every built page, which is why
# this is listed rather than just left alone.
reorder/

# Manuscript caption drafts (.docx), kept locally alongside the repo. Same
# reason as reorder/ above: an untracked directory leaks into the workflowr
# status report embedded in every built page.
captions/

# Collaborator's original cluster-side flashier fitting code, kept locally as
# the source for the Methods_FlashierFit page. The fit itself is distributed
# as flashier_snmf.rds rather than as code -- see code/README.md.
code/other/topic_flashier_20250212.R
code/other/topic_wrapper_20250215_alldata_backfit.sh
